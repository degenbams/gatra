# Pin the public npm registry for this project.
#
# A user-level ~/.npmrc pointing at a regional mirror (for example
# mirrors.tencentyun.com) rewrites the "resolved" URLs in package-lock.json
# on every `npm install`. Those hosts are not resolvable from the build
# machine, so the deployment fails with ENOTFOUND before it ever compiles.
# A project-level .npmrc takes precedence, which keeps the lockfile portable.
registry=https://registry.npmjs.org/
